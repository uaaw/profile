---
import CrystalCanvas from './CrystalCanvas.astro';
---
<nav class="navbar">
  <a href="/" class="nav-brand">
    <span class="nav-crystal" aria-hidden="true">
      <CrystalCanvas />
    </span>
    <span>eris</span>
  </a>
  <ul class="nav-links">
    <li><a href="/">About</a></li>
    <li><a href="/vuln/">Vuln</a></li>
    <li><a href="/project/">Project</a></li>
    <li><a href="/tech-stack/">Tech Stack</a></li>
  </ul>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 clamp(0.75rem, 3vw, 2rem);
    height: 56px;
    background: rgba(30, 30, 40, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Bebas Neue', sans-serif;
    color: #1a1e2e;
    font-size: 1.5rem;
    font-weight: 400;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .nav-brand:hover {
    color: #4a5568;
  }

  .nav-crystal {
    display: inline-block;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-links a {
    color: #3a4060;
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #1a1e2e;
  }

  @media (max-width: 540px) {
    .nav-brand {
      font-size: 1.2rem;
    }

    .nav-crystal {
      width: 20px;
      height: 20px;
      flex-basis: 20px;
    }

    .nav-links a {
      font-size: 0.8rem;
    }
  }
</style>
